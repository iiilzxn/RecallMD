{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RecallMD",
  "version": "0.3.1",
  "identifier": "com.recallmd.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RecallMD",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/speech-runtime/onnxruntime.dll": "onnxruntime.dll",
      "resources/speech-runtime/onnxruntime_providers_shared.dll": "onnxruntime_providers_shared.dll",
      "resources/speech-runtime/sherpa-onnx-c-api.dll": "sherpa-onnx-c-api.dll",
      "resources/speech-runtime/sherpa-onnx-cxx-api.dll": "sherpa-onnx-cxx-api.dll"
    },
    "publisher": "RecallMD Project",
    "shortDescription": "本地 Markdown 编辑器 + FSRS 间隔复习",
    "licenseFile": "nsis-license.txt",
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "languages": [
          "SimpChinese"
        ]
      }
    },
    "icon": [
      "icons/recallmd-v2/32x32.png",
      "icons/recallmd-v2/128x128.png",
      "icons/recallmd-v2/128x128@2x.png",
      "icons/recallmd-v2/icon.icns",
      "icons/recallmd-v2/icon.ico"
    ]
  }
}
